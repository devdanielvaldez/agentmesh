# Copy to demo/.env and fill in. demo/.env is gitignored and never committed.
# The GitHub MCP server needs a classic or fine-grained personal access token.
GITHUB_PERSONAL_ACCESS_TOKEN=replace-with-your-token
# Limit GitHub tools to the read-only repos toolset for a safe tour.
GITHUB_TOOLSETS=repos
# Model used by the agent for planning (must be pulled in Ollama).
OLLAMA_MODEL=llama3.2:1b
